      "clock": { "kind": "time_only", "upscale": 2.5, "adaptive_threshold": true, "attempts": 3, "whitelist": "digits_time" }
    }
  },
  "composite_layout": {
    "rows": [["main_chart", "volume"], ["tape", "book"]],
    "cell_max_width": 640,
    "padding": 4,
    "labels": true
  }
